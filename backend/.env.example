# Presenters Feedback Backend - Local Development Environment
# Copy this file to .env and adjust values as needed.
#
# Usage: cp .env.example .env

# Set to true to bypass Cognito auth and use mock AWS services
LOCAL_DEV=true

# AWS region
AWS_REGION=us-east-1

# S3 bucket for audio uploads
S3_BUCKET=presenters-feedback-dev

# DynamoDB table for analysis results
DYNAMODB_TABLE=presenters-feedback-dev

# Cognito (not needed when LOCAL_DEV=true)
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Bedrock model ID for AI analysis
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Presigned URL expiry in seconds
UPLOAD_URL_EXPIRY=300

# Max audio file size in MB
MAX_AUDIO_SIZE_MB=50
