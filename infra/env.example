# Local development environment variables
# Copy this file to ../backend/.env and fill in values

# Set to true to bypass Cognito auth and use mock AWS services
LOCAL_DEV=true

# AWS region
AWS_REGION=us-east-1

# S3 bucket for audio uploads (use LocalStack endpoint locally)
S3_BUCKET=presenters-feedback-audio-dev

# DynamoDB table for analysis results
DYNAMODB_TABLE=presenters-feedback-dev

# Cognito (not needed when LOCAL_DEV=true)
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Bedrock model ID
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# CORS allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Presigned URL expiry in seconds
UPLOAD_URL_EXPIRY=300

# Max audio file size in MB
MAX_AUDIO_SIZE_MB=50

# LocalStack endpoint (for local S3/DynamoDB)
# Uncomment when using LocalStack:
# AWS_ENDPOINT_URL=http://localhost:4566
